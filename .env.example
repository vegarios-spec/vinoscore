# VinoScore - variables de entorno
# Copia este archivo como ".env" y llena los valores. NUNCA subas el ".env" al repositorio.

# ---- API (prototipo) -------------------------------------------------------
# Base de datos. Si se omite, usa SQLite local (vinoscore.db en la raíz).
# Para PostgreSQL (Supabase, Render, etc.) basta con cambiar esta línea:
#   DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@SERVIDOR:5432/vinoscore
DATABASE_URL=

# Orígenes que pueden llamar a la API (separados por coma). En producción: la URL de la web.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rutas del modelo (opcional; por defecto están en modelo/)
MODELO_PATH=
METRICAS_PATH=

# Valores iniciales de la configuración (Sergio los cambia desde la web)
UMBRAL_INICIAL=0.5
COSTO_FALSO_PREMIUM_INICIAL=500
COSTO_BUENO_PERDIDO_INICIAL=1500

# ---- Web (archivo web/.env) -----------------------------------------------
# URL de la API. Vacío = misma dirección (modo desarrollo con proxy o modo un solo servicio).
VITE_API_URL=

# ---- Ruta a producción (aún NO se usan en el prototipo) --------------------
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo en el servidor, nunca en la web ni en la app móvil:
SUPABASE_SERVICE_ROLE_KEY=

# Monitoreo de errores (opcional)
SENTRY_DSN=

# Expo / app móvil (opcional)
EXPO_TOKEN=
